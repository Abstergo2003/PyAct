{
  "cells": [
    {
      "cell_type": "code",
      "source": [
        "import pamd_helpers\n",
        "from datetime import datetime\n",
        "from PIL import Image, ImageDraw\n",
        "\n",
        "def context():\n",
        "    # 1. LaTeX Equations with Greek symbols and subscripts\n",
        "    f_cd = lambda f_ck, gamma_c: f_ck / gamma_c\n",
        "    eq_strength = pamd_helpers.equation(f_cd, [30, 1.5])\n",
        "    \n",
        "    sigma_max = lambda M_Ed, W_el: M_Ed / W_el\n",
        "    eq_stress = pamd_helpers.equation(sigma_max, [250, 125])\n",
        "    \n",
        "    # 2. Plotting via pamd_helpers.plot\n",
        "    img = Image.new('RGB', (600, 260), color=(248, 250, 252))\n",
        "    d = ImageDraw.Draw(img)\n",
        "    d.rectangle([20, 20, 580, 240], outline=(43, 108, 176), width=3)\n",
        "    d.line([(40, 200), (560, 200)], fill=(160, 174, 192), width=2)\n",
        "    points = [(40 + i * 26, 200 - int(150 * (i/10) * (2 - i/10))) for i in range(21)]\n",
        "    for j in range(len(points) - 1):\n",
        "        d.line([points[j], points[j+1]], fill=(197, 48, 48), width=3)\n",
        "    d.text((60, 40), \"Beam Deflection & Bending Moment Diagram\", fill=(26, 54, 93))\n",
        "    plot_md = pamd_helpers.plot(img, caption=\"Bending Moment & Deflection Curve\", filename=\"beam_moment.png\")\n",
        "    \n",
        "    # 3. Callout / Alert\n",
        "    safety_callout = pamd_helpers.callout(\"Structural safety check complies with Eurocode EN 1992-1-1 requirements.\", callout_type=\"important\", title=\"Compliance Notice\")\n",
        "    \n",
        "    # 4. Standard and Wide Tables\n",
        "    headers = [\"Element\", \"Dimension\", \"Material\", \"Status\"]\n",
        "    rows = [\n",
        "        [\"Primary Beam\", \"IPE 300\", \"Steel S355\", \"Pass\"],\n",
        "        [\"Secondary Beam\", \"IPE 200\", \"Steel S275\", \"Pass\"],\n",
        "        [\"Column\", \"HEB 260\", \"Steel S355\", \"Pass\"]\n",
        "    ]\n",
        "    summary_table = pamd_helpers.table(headers, rows, \"Structural Elements Summary\", add_no=True)\n",
        "    \n",
        "    wide_headers = [\"Profile\", \"Height (mm)\", \"Width (mm)\", \"Web (mm)\", \"Flange (mm)\", \"Area (cm2)\", \"Weight (kg/m)\", \"Iz (cm4)\", \"Iy (cm4)\"]\n",
        "    wide_rows = [\n",
        "        [\"IPE 200\", \"200\", \"100\", \"5.6\", \"8.5\", \"28.5\", \"22.4\", \"1940\", \"142\"],\n",
        "        [\"IPE 300\", \"300\", \"150\", \"7.1\", \"10.7\", \"53.8\", \"42.2\", \"8360\", \"604\"],\n",
        "        [\"IPE 400\", \"400\", \"180\", \"8.6\", \"13.5\", \"84.5\", \"66.3\", \"23130\", \"1320\"],\n",
        "        [\"IPE 500\", \"500\", \"200\", \"10.2\", \"16.0\", \"116.0\", \"90.7\", \"48200\", \"2140\"]\n",
        "    ]\n",
        "    wide_table = pamd_helpers.table(wide_headers, wide_rows, \"Detailed Cross-Section Catalog\", add_no=False)\n",
        "    \n",
        "    # 5. Lists with restart verification\n",
        "    list1 = pamd_helpers.ordered_list([\"Initialize design criteria\", \"Calculate external loading\", \"Perform structural analysis\"])\n",
        "    list2 = pamd_helpers.ordered_list([\"Verify shear resistance\", \"Check deflection limit\", \"Produce fabrication drawings\"])\n",
        "    bullets = pamd_helpers.unordered_list([\"Limit State Design\", \"Dynamic Analysis\", \"Nonlinear Buckling\"])\n",
        "    tasks = pamd_helpers.checklist([\"Verify material certificates\", \"Inspect weld details\", \"Final signoff\"])\n",
        "    \n",
        "    # 6. Media, Links, and Footnotes\n",
        "    link = pamd_helpers.hyperlink(\"Eurocode Design Standards\", \"https://eurocodes.jrc.ec.europa.eu/\")\n",
        "    fn = pamd_helpers.Footnote(1, \"Values based on EN 1993-1-1 design specification tables.\")\n",
        "    \n",
        "    return {\n",
        "        \"title\": \"PyAct Comprehensive Feature Showcase\",\n",
        "        \"author\": \"Radek\",\n",
        "        \"date\": datetime.now().strftime(\"%Y-%m-%d\"),\n",
        "        \"eq_strength\": eq_strength,\n",
        "        \"eq_stress\": eq_stress,\n",
        "        \"plot\": plot_md,\n",
        "        \"callout\": safety_callout,\n",
        "        \"summary_table\": summary_table,\n",
        "        \"wide_table\": wide_table,\n",
        "        \"list1\": list1,\n",
        "        \"list2\": list2,\n",
        "        \"bullets\": bullets,\n",
        "        \"tasks\": tasks,\n",
        "        \"link\": link,\n",
        "        \"fn_ref\": fn.adnotation(),\n",
        "        \"fn_def\": fn.define_string()\n",
        "    }\n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# <ctx>title</ctx>\n",
        "\n",
        "Project: **<glb>project_code</glb>** | Organization: **<glb>organization</glb>** | Engine Version: **<glb>system_version</glb>**  \n",
        "Author: **<ctx>author</ctx>** | Date: *<ctx>date</ctx>*\n",
        "\n",
        "<ctx>author</ctx>\n",
        "\n",
        "<toc/>\n",
        "\n",
        "<pagebreak/>\n",
        "\n",
        "## 1. Executive Summary & Compliance\n",
        "This document validates all features of the PyAct compilation engine.\n",
        "\n",
        "<ctx>callout</ctx>\n",
        "\n",
        "Key design methodologies:\n",
        "<ctx>bullets</ctx>\n",
        "\n",
        "## 2. Mathematical Computations\n",
        "Equations are automatically parsed from Python lambda functions to LaTeX with Greek symbols and subscripts:\n",
        "\n",
        "**Design Compressive Strength:**\n",
        "<ctx>eq_strength</ctx>\n",
        "\n",
        "**Maximum Normal Stress:**\n",
        "<ctx>eq_stress</ctx>\n",
        "\n",
        "Inline equation example: The fundamental identity is $ a^2 + b^2 = c^2 $ for right-angled triangles.\n",
        "\n",
        "<pagebreak/>\n",
        "\n",
        "## 3. Graphical Analysis & Plots\n",
        "Generated directly using `pamd_helpers.plot`:\n",
        "\n",
        "<ctx>plot</ctx>\n",
        "\n",
        "## 4. Verification Workflow\n",
        "List numbering automatically restarts at 1 for distinct ordered lists:\n",
        "\n",
        "### Phase 1: Analysis\n",
        "<ctx>list1</ctx>\n",
        "\n",
        "### Phase 2: Design Verification\n",
        "<ctx>list2</ctx>\n",
        "\n",
        "### Quality Checklist\n",
        "<ctx>tasks</ctx>\n",
        "\n",
        "<pagebreak/>\n",
        "\n",
        "## 5. Component Summary\n",
        "Reference documentation: <ctx>link</ctx><ctx>fn_ref</ctx>.\n",
        "\n",
        "<ctx>summary_table</ctx>\n",
        "\n",
        "<landscape>\n",
        "# Appendix: Wide Profile Properties (Landscape Orientation)\n",
        "The section below switches orientation to landscape for wide tables:\n",
        "\n",
        "<ctx>wide_table</ctx>\n",
        "</landscape>\n",
        "\n",
        "## 6. Footnotes & References\n",
        "---\n",
        "<ctx>fn_def</ctx>\n"
      ]
    }
  ]
