{
  "name": "pamd-file-support",
  "displayName": "PAMD file support",
  "description": "Custom editing, compilation, linting, and DOCX export for PyAct .pamd documents.",
  "icon": "file_icon.png",
  "version": "2.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abstergo2003/PyAct.git",
    "directory": "pamd-file-support"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "publisher": "Abstergo",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pamd",
        "extensions": [
          ".pamd"
        ],
        "icon": {
          "light": "./file_icon.png",
          "dark": "./file_icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "pamd-editor",
        "displayName": "PAMD Editor",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.pamd"
          }
        ]
      }
    ],
    "grammars": [
      {
        "scopeName": "text.pamd.markdown",
        "path": "./syntaxes/pamd-markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "commands": [
      {
        "command": "pamd.actions",
        "title": "PyAct",
        "icon": "$(rocket)"
      },
      {
        "command": "pamd.generateDocx",
        "title": "Export to Word (.docx)",
        "icon": "$(export)"
      },
      {
        "command": "pamd.compileMarkdown",
        "title": "Compile to Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "pamd.compileNoCache",
        "title": "Compile to Markdown (No Cache)",
        "icon": "$(sync)"
      },
      {
        "command": "pamd.lint",
        "title": "Lint PAMD Project",
        "icon": "$(check)"
      },
      {
        "command": "pamd.clearCache",
        "title": "Clear PAMD Cache",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pamd.actions",
          "group": "navigation",
          "when": "resourceExtname == .pamd"
        },
        {
          "command": "pamd.compileMarkdown",
          "group": "navigation",
          "when": "resourceExtname == .pamd"
        },
        {
          "command": "pamd.generateDocx",
          "group": "navigation",
          "when": "resourceExtname == .pamd"
        },
        {
          "command": "pamd.lint",
          "group": "navigation",
          "when": "resourceExtname == .pamd"
        },
        {
          "command": "pamd.clearCache",
          "group": "navigation",
          "when": "resourceExtname == .pamd"
        },
        {
          "command": "pamd.compileNoCache",
          "group": "navigation",
          "when": "resourceExtname == .pamd"
        }
      ]
    },
    "configuration": {
      "title": "PyAct",
      "properties": {
        "pyact.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run the PyAct CLI."
        },
        "pyact.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated Markdown preview after compilation."
        },
        "pyact.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Output directory relative to the .pamd file. Empty uses the source directory."
        },
        "pyact.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show the PyAct toolbar inside the custom PAMD editor."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
