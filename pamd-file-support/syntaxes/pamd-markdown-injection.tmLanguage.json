{
  "scopeName": "text.pamd.markdown",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "name": "meta.tag.pamd.ctx",
      "match": "(<ctx>)([^<]+)(</ctx>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.pamd"
        },
        "2": {
          "name": "entity.name.tag.pamd.content"
        },
        "3": {
          "name": "punctuation.definition.tag.pamd"
        }
      }
    },
    {
      "name": "meta.tag.pamd.glb",
      "match": "(<glb>)([^<]+)(</glb>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.pamd"
        },
        "2": {
          "name": "entity.name.tag.pamd.content"
        },
        "3": {
          "name": "punctuation.definition.tag.pamd"
        }
      }
    },
    {
      "name": "meta.tag.pamd.tmp",
      "match": "(<tmp>)([^<]+)(</tmp>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.pamd"
        },
        "2": {
          "name": "string.unquoted.pamd"
        },
        "3": {
          "name": "punctuation.definition.tag.pamd"
        }
      }
    },
    {
      "name": "entity.name.tag.pamd",
      "match": "<(?:toc|pagebreak|sectionbreak|landscape|pb|sb)(?:\\s+[^>]*)?\\s*/?>|</(?:landscape)>"
    }
  ]
}
