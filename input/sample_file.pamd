      "source": [
        "### Test\n",
        "\n",
        "<ctx>var1</ctx>\n",
        "\n",
        "<ctx>var_2</ctx>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def dyn(inp: float):\n",
        "    return inp + 2\n",
        "\n",
        "def context():\n",
        "    numb = dyn(2)\n",
        "    return {\n",
        "        \"var1\": \"test1\",\n",
        "        \"var_2\": numb\n",
        "    }"
      ]
    }
  ]
}